# Streamlit secrets template
#
# Local development:
#   1. Copy this file to `.streamlit/secrets.toml`
#   2. Fill in your Groq API key (https://console.groq.com/keys)
#   3. `secrets.toml` is gitignored and will never be committed.
#
# Streamlit Community Cloud:
#   Do NOT commit a real secrets.toml. Instead paste the key below into
#   App settings -> Secrets in the Streamlit dashboard.

GROQ_API_KEY = ""
